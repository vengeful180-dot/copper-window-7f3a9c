# Frontend build (public values, not secrets)
WORKER_API_URL=https://your-worker.your-subdomain.workers.dev

# Cloudflare Worker secrets / settings
SITE_AUTH_TOKEN_HASH=generated-by-npm-run-secrets-bootstrap
ADMIN_PASSWORD_HASH=generated-by-npm-run-secrets-bootstrap
ADMIN_PASSWORD_SALT=generated-by-npm-run-secrets-bootstrap
ADMIN_SESSION_SECRET=generated-by-npm-run-secrets-bootstrap
ACCOUNT_LOOKUP_SECRET=generated-random-secret
ACCOUNT_SESSION_SECRET=generated-random-secret
ACCOUNT_STORAGE_SECRET=generated-random-secret
GITHUB_DATA_TOKEN=github-fine-grained-token
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-private-data-repository
GITHUB_BRANCH=main
ALLOWED_ORIGIN=https://your-owner.github.io
